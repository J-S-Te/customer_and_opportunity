# Independent Portal schema connection. Do not point this process at CRM.
PORTAL_PROJECT_MYSQL_DSN=portal:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_PROJECT_TENANT_ID=
PORTAL_PROJECT_WORKER_ID=

# Customer-scoped incremental pull. Defaults preserve the CP-002 five-minute
# freshness target and support multi-instance leasing through MySQL.
PORTAL_PROJECT_POLL_INTERVAL=5s
PORTAL_PROJECT_SYNC_INTERVAL=5m
PORTAL_PROJECT_LEASE_DURATION=1m
PORTAL_PROJECT_RETRY_INTERVAL=1m
PORTAL_PROJECT_PAGE_SIZE=100

# Dedicated Portal -> project-service OAuth Client Credentials client.
# The base platform token endpoint accepts client_secret_basic and form fields
# grant_type + scope only; this worker never sends an audience parameter.
PORTAL_PROJECT_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_PROJECT_CLIENT_ID=
PORTAL_PROJECT_CLIENT_SECRET=
PORTAL_PROJECT_SCOPE=project.snapshot.read
PORTAL_PROJECT_SNAPSHOTS_URL=https://project.example.com/api/v1/projects/snapshots
PORTAL_PROJECT_TOKEN_TIMEOUT=5s
PORTAL_PROJECT_REQUEST_TIMEOUT=10s

# Optional private trust/mTLS for both token and project endpoints. Client key
# material must come from a runtime secret mount.
PORTAL_PROJECT_TLS_ROOT_CA_FILE=
PORTAL_PROJECT_TLS_CLIENT_CERT_FILE=
PORTAL_PROJECT_TLS_CLIENT_KEY_FILE=
PORTAL_PROJECT_TLS_SERVER_NAME=
PORTAL_PROJECT_TLS_REQUIRE_MTLS=false
