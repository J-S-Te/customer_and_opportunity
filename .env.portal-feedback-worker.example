# Dedicated customer_portal schema worker account.
PORTAL_FEEDBACK_WORKER_MYSQL_DSN=portal_feedback_worker:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_FEEDBACK_WORKER_ID=portal-feedback-worker-1
PORTAL_FEEDBACK_WORKER_TENANT_ID=tenant-id
PORTAL_FEEDBACK_WORKER_POLL_INTERVAL=1m
PORTAL_FEEDBACK_WORKER_LEASE_DURATION=30s
PORTAL_FEEDBACK_WORKER_BATCH_SIZE=100

# 单进程独立连接池预算；多副本需累加计算总连接上限。
WORKER_DB_MAX_OPEN_CONNS=5
WORKER_DB_MAX_IDLE_CONNS=2
WORKER_DB_CONN_MAX_LIFETIME=15m
WORKER_DB_CONN_MAX_IDLE_TIME=2m
