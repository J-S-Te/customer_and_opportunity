# CRM schema connection. Use a least-privilege account that can scan
# opportunities and manage BM-002 alert/rule/outbox/lease rows.
MYSQL_DSN=crm_opportunity_alert_worker:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC

# Independent BM-002 scanner. All duration arithmetic is UTC. The default
# cadence follows the approved ten-minute requirement.
OPPORTUNITY_ALERT_WORKER_ID=crm-opportunity-alert-worker-1
OPPORTUNITY_ALERT_POLL_INTERVAL=10m
OPPORTUNITY_ALERT_LEASE_DURATION=1m
OPPORTUNITY_ALERT_BATCH_SIZE=200
