# Portal is an independent deployment and must point to the customer_portal
# schema. Do not reuse the CRM DSN, OAuth client, cookie, or machine secret.
PORTAL_HTTP_ADDRESS=:8091
PORTAL_MYSQL_DSN=portal:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_PATH_PREFIX=/customer-portal
PORTAL_PUBLIC_ORIGIN=https://portal.example.com

PORTAL_OIDC_ISSUER=https://identity.example.com
PORTAL_OIDC_BACKCHANNEL_BASE_URL=http://platform-api:8080
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_REDIRECT_URI=https://portal.example.com/customer-portal/auth/callback
PORTAL_OIDC_SCOPES=openid profile
PORTAL_OIDC_TENANT_ID=
PORTAL_ROLE_CONFIG_HASH=

# Portal authorization catalog publisher; independent from CRM and browser
# OIDC credentials. Enable after subsystem onboarding has created the client.
PORTAL_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PORTAL_PLATFORM_BASE_URL=https://identity.example.com
PORTAL_AUTHORIZATION_CATALOG_APPLICATION_ID=
PORTAL_AUTHORIZATION_CATALOG_CLIENT_ID=
PORTAL_AUTHORIZATION_CATALOG_CLIENT_SECRET=
PORTAL_ACCOUNT_SECURITY_CENTER_URL=https://identity.example.com/account/security

PORTAL_SESSION_COOKIE_NAME=customer_portal_session
PORTAL_SESSION_COOKIE_SECURE=true
PORTAL_SESSION_TTL=15m

# Portal inbound integrations verify application JWTs using only the platform
# Ed25519 public key. These match AUTH_JWT_ISSUER and
# AUTH_APPLICATION_JWT_AUDIENCE; the OIDC JWKS is not an application-token key.
PORTAL_MACHINE_TOKEN_ISSUER=basic-platform
PORTAL_MACHINE_TOKEN_AUDIENCE=basic-platform-application
PORTAL_MACHINE_TOKEN_PUBLIC_KEY_PATH=/run/secrets/basic-platform-application-jwt-public.pem
PORTAL_CRM_INVITE_BASE_URL=http://crm-server:8090/customer-opportunity/api/v1
PORTAL_CRM_INVITE_TOKEN_URL=http://platform-api:8080/oauth2/token
PORTAL_CRM_INVITE_CLIENT_ID=
PORTAL_CRM_INVITE_CLIENT_SECRET=
PORTAL_CRM_INVITE_SCOPE=portal.invite.verify

# Independent random values. Both encryption keys decode to exactly 32 bytes;
# HMAC to at least 32 bytes. Descriptor and general encryption keys must also
# differ from each other; none may be shared with CRM.
PORTAL_ENCRYPTION_KEY_BASE64=
PORTAL_REPORT_INGEST_DESCRIPTOR_KEY_BASE64=
PORTAL_HMAC_KEY_BASE64=

# portal-report-worker uses the same dedicated descriptor key so it can decrypt
# durable jobs. Keep the project-service OAuth client limited to one scope.
PORTAL_REPORT_WORKER_MYSQL_DSN=portal:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_REPORT_WORKER_ID=
PORTAL_REPORT_WORKER_POLL_INTERVAL=1s
PORTAL_REPORT_WORKER_LEASE_DURATION=30s
PORTAL_REPORT_WORKER_BATCH_SIZE=20
PORTAL_REPORT_PROJECT_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_REPORT_PROJECT_CLIENT_ID=
PORTAL_REPORT_PROJECT_CLIENT_SECRET=
PORTAL_REPORT_PROJECT_SCOPE=report.request.write
PORTAL_REPORT_PROJECT_REQUEST_URL=https://project.example.com/report-requests
PORTAL_REPORT_PROJECT_TLS_ROOT_CA_FILE=
PORTAL_REPORT_PROJECT_TLS_CLIENT_CERT_FILE=
PORTAL_REPORT_PROJECT_TLS_CLIENT_KEY_FILE=
PORTAL_REPORT_PROJECT_TLS_SERVER_NAME=
PORTAL_REPORT_PROJECT_TLS_REQUIRE_MTLS=true
