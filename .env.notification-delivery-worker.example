# CRM 站内信双写平台 worker。Apply migration 000098 before starting.
MYSQL_DSN=

NOTIFICATION_DELIVERY_WORKER_ID=crm-notification-delivery-worker-1
NOTIFICATION_DELIVERY_POLL_INTERVAL=5s
NOTIFICATION_DELIVERY_BATCH_SIZE=100

# 平台机器凭据，仅授予 notification.ingest；未配置时 worker 不投递并直接退出。
PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_NOTIFICATION_CLIENT_ID=
PLATFORM_NOTIFICATION_CLIENT_SECRET=
PLATFORM_APPLICATION_CODE=customer_and_opportunity
PLATFORM_ENVIRONMENT_CODE=dev
