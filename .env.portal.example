PORTAL_HTTP_ADDRESS=:8091
PORTAL_PATH_PREFIX=/customer-portal
PORTAL_PUBLIC_ORIGIN=https://portal.example.com
PORTAL_MYSQL_DSN=portal:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC

# Base-platform OIDC Authorization Code + PKCE client. Redirect URI must be
# registered exactly and resolve to PORTAL_PATH_PREFIX/auth/callback.
# Set to the Keycloak Realm URL for migration, for example
# https://sso.example.com/realms/basic-platform. Roll back by restoring the
# previous issuer and restarting Portal; no Portal database migration is needed.
PORTAL_OIDC_ISSUER=https://identity.example.com
PORTAL_OIDC_BACKCHANNEL_BASE_URL=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_REDIRECT_URI=https://portal.example.com/customer-portal/auth/callback
PORTAL_OIDC_SCOPES=openid profile
PORTAL_OIDC_IDP_HINT=basic-platform-customer
PORTAL_OIDC_TENANT_ID=
PORTAL_ROLE_CONFIG_HASH=

# Portal publishes an independent authorization catalog with its own
# application-bound publisher credential. Do not reuse the CRM publisher.
PORTAL_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PORTAL_PLATFORM_BASE_URL=https://identity.example.com
PORTAL_AUTHORIZATION_CATALOG_APPLICATION_ID=
PORTAL_AUTHORIZATION_CATALOG_CLIENT_ID=
PORTAL_AUTHORIZATION_CATALOG_CLIENT_SECRET=

# Trusted base-platform account security center. The Portal appends only its
# configured same-site return URL; no browser-supplied redirect is forwarded.
PORTAL_ACCOUNT_SECURITY_CENTER_URL=https://identity.example.com/account/security

# Portal owns an independent HttpOnly server-side session cookie.
PORTAL_SESSION_COOKIE_NAME=customer_portal_session
PORTAL_SESSION_COOKIE_SECURE=true
PORTAL_SESSION_TTL=15m

# Independent random values. Encryption must decode to exactly 32 bytes and
# HMAC to at least 32 bytes. Do not reuse CRM keys.
PORTAL_ENCRYPTION_KEY_BASE64=
PORTAL_HMAC_KEY_BASE64=

# Portal verifies inbound application JWTs locally with the platform's read-only
# Ed25519 public key. Values must match AUTH_JWT_ISSUER and
# AUTH_APPLICATION_JWT_AUDIENCE; never mount the platform private key.
PORTAL_MACHINE_TOKEN_ISSUER=basic-platform
PORTAL_MACHINE_TOKEN_AUDIENCE=basic-platform-application
PORTAL_MACHINE_TOKEN_PUBLIC_KEY_PATH=/run/secrets/basic-platform-application-jwt-public.pem
# Exact application-JWT `sub` values issued to the two independent CRM ->
# Portal clients. Scope alone is insufficient authorization for account routes.
PORTAL_CRM_PROVISION_CLIENT_SUBJECT=
PORTAL_CRM_DISABLE_CLIENT_SUBJECT=
# Project history returned to CRM contains only locally synchronized project
# summaries. Rows older than this local synced_at threshold are marked stale;
# this does not claim the upstream project system is live or current.
PORTAL_PROJECT_HISTORY_STALE_AFTER=10m

# Dedicated Portal -> CRM client_credentials client. The platform token endpoint
# accepts client_secret_basic with grant_type and scope only. CRM verifies the
# platform's deployment-wide application-token audience independently.
PORTAL_CRM_INVITE_BASE_URL=https://crm.example.com/customer-opportunity/api/v1
PORTAL_CRM_INVITE_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_CRM_INVITE_CLIENT_ID=
PORTAL_CRM_INVITE_CLIENT_SECRET=
PORTAL_CRM_INVITE_SCOPE=portal.invite.verify
