# CRM schema with migrations through 000048.
MYSQL_DSN=crm:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC
# Diagnostic instance label only. Each claimed row also receives a fresh random
# fencing token, so replicas remain isolated even if this label is duplicated.
CONTRACT_TRANSFER_WORKER_ID=crm-contract-transfer-1
CONTRACT_TRANSFER_POLL_INTERVAL=5s
# Must cover one authority read plus one token/intake HTTP attempt. The worker
# claims only one event at a time; BATCH_SIZE is the maximum events per poll.
CONTRACT_TRANSFER_LEASE_DURATION=1m
CONTRACT_TRANSFER_BATCH_SIZE=20

# Dedicated platform client_credentials client. Do not reuse browser, Portal,
# PMS, approval, audit, or catalog synchronization credentials.
CONTRACT_TOKEN_URL=https://identity.example.com/oauth2/token
CONTRACT_CLIENT_ID=crm-contract-transfer
CONTRACT_CLIENT_SECRET=
CONTRACT_SCOPE=opportunity.signed.write
CONTRACT_OPPORTUNITY_INTAKE_URL=https://contract.example.com/internal/opportunity-signed-events

# Optional private trust/mTLS. When REQUIRE_MTLS=true both client files are
# required and the token and intake endpoints must use HTTPS. Mount keys from a
# secret store; never bake them into the image or repository.
CONTRACT_TLS_ROOT_CA_FILE=
CONTRACT_TLS_CLIENT_CERT_FILE=
CONTRACT_TLS_CLIENT_KEY_FILE=
CONTRACT_TLS_SERVER_NAME=
CONTRACT_TLS_REQUIRE_MTLS=false
