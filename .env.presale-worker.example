# CRM database. Apply CRM migration 000012 before starting this worker.
MYSQL_DSN=crm:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC

# Multi-instance lease/claim settings.
PRESALE_WORKER_ID=crm-presale-worker-1
PRESALE_WORKER_POLL_INTERVAL=1s
PRESALE_WORKER_HEARTBEAT_MAX_AGE=15s
PRESALE_WORKER_LEASE_DURATION=30s
PRESALE_WORKER_BATCH_SIZE=20
# Use the same freshness window in CRM and presale-worker. Startup rejects a
# value that does not cover poll interval, five-second HTTP timeout and jitter.

# Approval engine OAuth Client Credentials. This client only has the approval scope.
APPROVAL_TOKEN_URL=https://identity.example.com/oauth/token
APPROVAL_CLIENT_ID=crm-presale-approval
APPROVAL_CLIENT_SECRET=
APPROVAL_SCOPE=presale.approval.write
APPROVAL_START_URL=https://approval.example.com/api/v1/presale/instances
APPROVAL_ACTION_URL=https://approval.example.com/api/v1/presale/actions
APPROVAL_TLS_ROOT_CA_FILE=/run/secrets/approval-ca.pem
APPROVAL_TLS_CLIENT_CERT_FILE=/run/secrets/approval-client.pem
APPROVAL_TLS_CLIENT_KEY_FILE=/run/secrets/approval-client-key.pem
APPROVAL_TLS_SERVER_NAME=approval.example.com
APPROVAL_TLS_REQUIRE_MTLS=true

# PMS OAuth Client Credentials. Use a different client with only the PMS write scope.
PMS_TOKEN_URL=https://identity.example.com/oauth/token
PMS_CLIENT_ID=crm-presale-pms
PMS_CLIENT_SECRET=
PMS_SCOPE=presale.worklog.write
PMS_WORKLOG_URL=https://pms.example.com/api/v1/presale/worklogs
PMS_TLS_ROOT_CA_FILE=/run/secrets/pms-ca.pem
PMS_TLS_CLIENT_CERT_FILE=/run/secrets/pms-client.pem
PMS_TLS_CLIENT_KEY_FILE=/run/secrets/pms-client-key.pem
PMS_TLS_SERVER_NAME=pms.example.com
PMS_TLS_REQUIRE_MTLS=true
