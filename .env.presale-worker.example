# All endpoint values are deployment inputs. They may point to local HTTPS
# services or remote servers and are never baked into the binary or image.
# Apply the CRM migration chain through 000072 before starting this worker.
# platform/compose.local.yaml overrides this DSN for its own MySQL service.
MYSQL_DSN=

# Multi-instance lease/claim settings.
PRESALE_WORKER_ID=crm-presale-worker-1
PRESALE_WORKER_POLL_INTERVAL=1s
PRESALE_WORKER_HEARTBEAT_MAX_AGE=15s
PRESALE_WORKER_LEASE_DURATION=30s
PRESALE_WORKER_BATCH_SIZE=20
# 仅限受控本地联调：允许审批/PMS 端点临时使用明文 HTTP。正式部署必须保持 false 并使用 HTTPS。
PRESALE_WORKER_ALLOW_INSECURE_HTTP=false
# Use the same freshness window in CRM and presale-worker. Startup rejects a
# value that does not cover poll interval, five-second HTTP timeout and jitter.

# Approval engine OAuth Client Credentials. This client only has the approval scope.
APPROVAL_TOKEN_URL=
APPROVAL_CLIENT_ID=
APPROVAL_CLIENT_SECRET=
APPROVAL_SCOPE=presale.approval.write
APPROVAL_START_URL=
APPROVAL_ACTION_URL=
APPROVAL_TLS_ROOT_CA_FILE=
APPROVAL_TLS_CLIENT_CERT_FILE=
APPROVAL_TLS_CLIENT_KEY_FILE=
APPROVAL_TLS_SERVER_NAME=
APPROVAL_TLS_REQUIRE_MTLS=false

# PMS OAuth Client Credentials. Use a different client with only the PMS write scope.
PMS_TOKEN_URL=
PMS_CLIENT_ID=
PMS_CLIENT_SECRET=
PMS_SCOPE=presale.worklog.write
PMS_WORKLOG_URL=
PMS_TLS_ROOT_CA_FILE=
PMS_TLS_CLIENT_CERT_FILE=
PMS_TLS_CLIENT_KEY_FILE=
PMS_TLS_SERVER_NAME=
PMS_TLS_REQUIRE_MTLS=false
