# CRM schema after migration 000030.
MYSQL_DSN=crm:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC
PMS_ENGINEER_SYNC_WORKER_ID=crm-pms-engineers-1
PMS_ENGINEER_SYNC_POLL_INTERVAL=15s
PMS_ENGINEER_SYNC_LEASE_DURATION=2m
PMS_ENGINEER_SYNC_BATCH_SIZE=10
PMS_ENGINEER_SYNC_INTERVAL=6h

# Dedicated OAuth Client Credentials with only technician.read.
PMS_ENGINEER_TOKEN_URL=https://identity.example.com/oauth/token
PMS_ENGINEER_CLIENT_ID=crm-pms-engineer-read
PMS_ENGINEER_CLIENT_SECRET=
PMS_ENGINEER_SCOPE=technician.read
PMS_ENGINEER_URL=https://pms.example.com/api/v1/pms/technicians
PMS_ENGINEER_TLS_ROOT_CA_FILE=/run/secrets/pms-ca.pem
PMS_ENGINEER_TLS_CLIENT_CERT_FILE=/run/secrets/pms-client.pem
PMS_ENGINEER_TLS_CLIENT_KEY_FILE=/run/secrets/pms-client-key.pem
PMS_ENGINEER_TLS_SERVER_NAME=pms.example.com
PMS_ENGINEER_TLS_REQUIRE_MTLS=true

# Separate 32-byte AEAD key for PMS contact cache, base64 encoded.
PMS_ENGINEER_SYNC_ENCRYPTION_KEY_BASE64=
