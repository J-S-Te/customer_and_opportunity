# Independent Portal schema connection. Do not point this process at CRM.
PORTAL_PROJECT_EXPORT_MYSQL_DSN=portal:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_PROJECT_EXPORT_WORKER_ID=

# A writable pdfcpu configuration root and an explicitly approved CJK TTF/OTF
# are mandatory. The worker fails startup instead of generating a placeholder.
PORTAL_PROJECT_EXPORT_PDF_CONFIG_ROOT=/var/lib/customer-portal/pdfcpu
PORTAL_PROJECT_EXPORT_CJK_FONT_PATH=/opt/customer-portal/fonts/approved-cjk.ttf

PORTAL_PROJECT_EXPORT_POLL_INTERVAL=1s
PORTAL_PROJECT_EXPORT_LEASE_DURATION=30s
