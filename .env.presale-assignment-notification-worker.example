# CRM schema only. This worker projects TS assignment events into personal inbox rows.
MYSQL_DSN=crm_app:change-me@tcp(127.0.0.1:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC
PRESALE_ASSIGNMENT_NOTIFICATION_WORKER_ID=presale-assignment-notification-worker-1
PRESALE_ASSIGNMENT_NOTIFICATION_POLL_INTERVAL=5s
PRESALE_ASSIGNMENT_NOTIFICATION_LEASE_DURATION=1m
PRESALE_ASSIGNMENT_NOTIFICATION_BATCH_SIZE=100

# 单进程独立连接池预算；多副本需累加计算总连接上限。
WORKER_DB_MAX_OPEN_CONNS=5
WORKER_DB_MAX_IDLE_CONNS=2
WORKER_DB_CONN_MAX_LIFETIME=15m
WORKER_DB_CONN_MAX_IDLE_TIME=2m
