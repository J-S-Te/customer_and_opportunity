# Independent process. This DSN must point to the customer_portal schema.
PORTAL_REPORT_WORKER_MYSQL_DSN=portal_report_worker:change-me@tcp(mysql:3306)/customer_portal?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_REPORT_WORKER_ID=portal-report-worker-1
PORTAL_REPORT_WORKER_POLL_INTERVAL=1s
PORTAL_REPORT_WORKER_LEASE_DURATION=30s
PORTAL_REPORT_WORKER_BATCH_SIZE=20

# Dedicated Portal -> project-service OAuth Client Credentials client.
# The platform token endpoint accepts client_secret_basic and a form containing
# only grant_type=client_credentials and scope; do not configure audience.
PORTAL_REPORT_PROJECT_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_REPORT_PROJECT_CLIENT_ID=
PORTAL_REPORT_PROJECT_CLIENT_SECRET=
PORTAL_REPORT_PROJECT_SCOPE=report.request.write
PORTAL_REPORT_PROJECT_REQUEST_URL=https://project.example.com/api/v1/report-requests
PORTAL_REPORT_PROJECT_TLS_ROOT_CA_FILE=/run/secrets/project-ca.pem
PORTAL_REPORT_PROJECT_TLS_CLIENT_CERT_FILE=/run/secrets/project-client.pem
PORTAL_REPORT_PROJECT_TLS_CLIENT_KEY_FILE=/run/secrets/project-client-key.pem
PORTAL_REPORT_PROJECT_TLS_SERVER_NAME=project.example.com
PORTAL_REPORT_PROJECT_TLS_REQUIRE_MTLS=true
