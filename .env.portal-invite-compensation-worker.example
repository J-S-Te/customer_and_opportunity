# Independent CM-004 compensation worker. Use the CRM schema and a dedicated
# Portal OAuth client with only portal.identity_mapping.provision.
PORTAL_INVITE_COMPENSATION_MYSQL_DSN=crm:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_INVITE_COMPENSATION_WORKER_ID=
PORTAL_INVITE_COMPENSATION_POLL_INTERVAL=5s
PORTAL_INVITE_COMPENSATION_LEASE_DURATION=1m
PORTAL_INVITE_COMPENSATION_BATCH_SIZE=20

PORTAL_INVITE_COMPENSATION_PORTAL_PROVISION_URL=https://portal.example.com/customer-portal/internal/accounts/provision
PORTAL_INVITE_COMPENSATION_PORTAL_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_INVITE_COMPENSATION_PORTAL_CLIENT_ID=
PORTAL_INVITE_COMPENSATION_PORTAL_CLIENT_SECRET=
PORTAL_INVITE_COMPENSATION_PORTAL_SCOPE=portal.identity_mapping.provision
PORTAL_INVITE_COMPENSATION_PORTAL_TLS_ROOT_CA_FILE=
PORTAL_INVITE_COMPENSATION_PORTAL_TLS_CLIENT_CERT_FILE=
PORTAL_INVITE_COMPENSATION_PORTAL_TLS_CLIENT_KEY_FILE=
PORTAL_INVITE_COMPENSATION_PORTAL_TLS_SERVER_NAME=
PORTAL_INVITE_COMPENSATION_PORTAL_TLS_REQUIRE_MTLS=false

# ASSIGN_PORTAL_ROLE uses a separate least-privilege platform client. Keep the
# worker stopped until the platform provider signs this strict consumer
# contract and issues the application_role.assign credential.
PORTAL_INVITE_COMPENSATION_PLATFORM_ROLE_ASSIGN_URL=https://identity.example.com/api/v1/internal/application-roles
PORTAL_INVITE_COMPENSATION_PLATFORM_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_INVITE_COMPENSATION_PLATFORM_CLIENT_ID=
PORTAL_INVITE_COMPENSATION_PLATFORM_CLIENT_SECRET=
PORTAL_INVITE_COMPENSATION_PLATFORM_SCOPE=application_role.assign
PORTAL_INVITE_COMPENSATION_PLATFORM_APPLICATION_CODE=customer-portal
PORTAL_INVITE_COMPENSATION_PLATFORM_TLS_ROOT_CA_FILE=
PORTAL_INVITE_COMPENSATION_PLATFORM_TLS_CLIENT_CERT_FILE=
PORTAL_INVITE_COMPENSATION_PLATFORM_TLS_CLIENT_KEY_FILE=
PORTAL_INVITE_COMPENSATION_PLATFORM_TLS_SERVER_NAME=
PORTAL_INVITE_COMPENSATION_PLATFORM_TLS_REQUIRE_MTLS=false
