# Independent recovery worker for CM-004 Portal access disable sagas. It owns
# no user provisioning or role-assignment authority.
PORTAL_ACCESS_DISABLE_MYSQL_DSN=crm:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC
PORTAL_ACCESS_DISABLE_WORKER_ID=
PORTAL_ACCESS_DISABLE_POLL_INTERVAL=5s
PORTAL_ACCESS_DISABLE_LEASE_DURATION=1m
PORTAL_ACCESS_DISABLE_BATCH_SIZE=20

# Platform audit outbox delivery for this worker. All values below are
# required; AUDIT_APPLICATION_CODE must stay exactly customer_and_opportunity.
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_BASE_URL=https://identity.example.com
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_CLIENT_ID=
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_CLIENT_SECRET=
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_APPLICATION_CODE=customer_and_opportunity
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_ENVIRONMENT_CODE=dev
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_WORKER_ID=portal-access-disable-audit
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_POLL_INTERVAL=1s
PORTAL_ACCESS_DISABLE_PLATFORM_AUDIT_BATCH_SIZE=100

# Default mode calls the Portal server disable endpoint. Set
# PORTAL_ACCESS_DISABLE_PLATFORM_ONLY=true to skip Portal and directly repair
# the platform external-user binding instead; that mode requires the three
# BINDING_* client values below and must not be combined with PORTAL_* ones.
PORTAL_ACCESS_DISABLE_PLATFORM_ONLY=false
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_BASE_URL=https://identity.example.com/api/v1/internal/external-users
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_CLIENT_ID=
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_CLIENT_SECRET=
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_SCOPE=portal_mapping_disable

# Dedicated Portal machine client; exact scope only.
PORTAL_ACCESS_DISABLE_PORTAL_URL=https://portal.example.com/customer-portal/internal/accounts/disable
PORTAL_ACCESS_DISABLE_PORTAL_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_ACCESS_DISABLE_PORTAL_CLIENT_ID=
PORTAL_ACCESS_DISABLE_PORTAL_CLIENT_SECRET=
PORTAL_ACCESS_DISABLE_PORTAL_SCOPE=portal.identity_mapping.disable
PORTAL_ACCESS_DISABLE_PORTAL_TLS_ROOT_CA_FILE=
PORTAL_ACCESS_DISABLE_PORTAL_TLS_CLIENT_CERT_FILE=
PORTAL_ACCESS_DISABLE_PORTAL_TLS_CLIENT_KEY_FILE=
PORTAL_ACCESS_DISABLE_PORTAL_TLS_SERVER_NAME=
PORTAL_ACCESS_DISABLE_PORTAL_TLS_REQUIRE_MTLS=false

# Separate platform role-revocation client; exact scope only. The worker must
# remain stopped until the provider contract and OAuth client are delivered.
PORTAL_ACCESS_DISABLE_PLATFORM_ROLE_REVOKE_URL=https://identity.example.com/api/v1/internal/application-roles/revoke
PORTAL_ACCESS_DISABLE_PLATFORM_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_ACCESS_DISABLE_PLATFORM_CLIENT_ID=
PORTAL_ACCESS_DISABLE_PLATFORM_CLIENT_SECRET=
PORTAL_ACCESS_DISABLE_PLATFORM_SCOPE=application_role.revoke
PORTAL_ACCESS_DISABLE_PLATFORM_APPLICATION_CODE=customer_portal
PORTAL_ACCESS_DISABLE_PLATFORM_TLS_ROOT_CA_FILE=
PORTAL_ACCESS_DISABLE_PLATFORM_TLS_CLIENT_CERT_FILE=
PORTAL_ACCESS_DISABLE_PLATFORM_TLS_CLIENT_KEY_FILE=
PORTAL_ACCESS_DISABLE_PLATFORM_TLS_SERVER_NAME=
PORTAL_ACCESS_DISABLE_PLATFORM_TLS_REQUIRE_MTLS=false
