HTTP_ADDRESS=:8090
APP_PATH_PREFIX=/customer-opportunity
APP_PUBLIC_ORIGIN=https://crm.example.com
MYSQL_DSN=crm:change-me@tcp(mysql:3306)/crm?charset=utf8mb4&parseTime=True&loc=UTC

# Header-based development identities are intentionally unsupported. Local and
# production environments both authenticate and authorize through Base Platform.
DEV_AUTH_ENABLED=false

# Base-platform OIDC Authorization Code + PKCE (always required).
# OIDC issuer used by the browser and token verifier. For Keycloak use the
# realm URL, e.g. https://sso.example.com/realms/basic-platform. To roll back,
# restore the previous issuer value; no CRM/portal database change is required.
OIDC_ISSUER=https://identity.example.com
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=crm-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://crm.example.com/customer-opportunity/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://crm.example.com/customer-opportunity/
OIDC_SCOPES=openid profile
OIDC_IDP_HINT=basic-platform
OIDC_TENANT_ID=
# Must equal the CRM authorization catalog claims_role_config_hash registered in the platform.
OIDC_ROLE_CONFIG_HASH=
OIDC_MAX_EFFECTIVE_ROLES=10
OIDC_SESSION_COOKIE_NAME=customer_opportunity_session
OIDC_SESSION_TTL=15m
OIDC_SESSION_COOKIE_SECURE=true
# Machine endpoints verify the platform application JWT locally with only its
# read-only Ed25519 public key. These must exactly match platform
# AUTH_JWT_ISSUER, AUTH_APPLICATION_JWT_AUDIENCE and AUTH_JWT_PUBLIC_KEY_PATH.
# Do not point this verifier at OIDC_ISSUER/JWKS and never mount the private key.
MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
MACHINE_TOKEN_PUBLIC_KEY_PATH=/run/secrets/basic-platform-application-jwt-public.pem

# Application-owned CRM authorization catalog publisher. This credential is
# created by subsystem onboarding, belongs to the CRM application, and must not
# be shared with the browser, audit, Portal or business-integration clients.
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PLATFORM_BASE_URL=https://identity.example.com
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=

# Every HTTP request is first reserved in a local durable audit outbox and then
# published to Base Platform. This must be a dedicated client_credentials client
# whose only scope is audit.ingest; startup fails when any value is absent.
PLATFORM_APPLICATION_CODE=customer_and_opportunity
PLATFORM_ENVIRONMENT_CODE=dev
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
PLATFORM_AUDIT_WORKER_ID=crm-api-audit
PLATFORM_AUDIT_POLL_INTERVAL=1s
PLATFORM_AUDIT_BATCH_SIZE=100

# Generate independent random values; each decoded key must be at least 32 bytes (encryption exactly 32 bytes).
SENSITIVE_ENCRYPTION_KEY_BASE64=
SENSITIVE_HMAC_KEY_BASE64=

# CM-001 customer XLSX import is fail-closed by default. The process bootstrap
# intentionally injects no ImportFileScanner until a deployment-specific scanner
# adapter is wired; preview returns CRM_CUSTOMER_IMPORT_SCANNER_UNAVAILABLE.

# BM-001 opportunity attachments are also fail-closed by default. The current
# bootstrap injects explicit unavailable object-store and malware-scanner ports;
# no upload session row is created until both production adapters are wired.
# The signed-upload/storage and scanner callback contracts must preserve the
# immutable object version, SHA-256, 20 MiB bound and public-ID idempotency key.

# CM-004 Portal invitation. PLATFORM_EXTERNAL_IDENTITY_ENABLED activates the
# strict consumer contract for platform external-user provisioning and Portal
# application-role assignment. Keep both switches false until the platform
# provider signs the request/response schema and issues two independent clients.
PORTAL_INVITE_ENABLED=false
PORTAL_PUBLIC_URL=https://portal.example.com/customer-portal
# Full endpoint: <Portal path prefix>/internal/accounts/provision
PORTAL_PROVISION_URL=https://portal.example.com/customer-portal/internal/accounts/provision
# Dedicated CRM -> Portal client_credentials client. The token endpoint accepts
# client_secret_basic with grant_type and scope only.
PORTAL_PROVISION_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_PROVISION_CLIENT_ID=
PORTAL_PROVISION_CLIENT_SECRET=
PORTAL_PROVISION_SCOPE=portal.identity_mapping.provision
PORTAL_DISABLE_URL=https://portal.example.com/customer-portal/internal/accounts/disable
# Use a separate client with only portal.identity_mapping.disable.
PORTAL_DISABLE_CLIENT_ID=
PORTAL_DISABLE_CLIENT_SECRET=
PORTAL_DISABLE_SCOPE=portal.identity_mapping.disable
PORTAL_PROVISION_TLS_ROOT_CA_FILE=
PORTAL_PROVISION_TLS_CLIENT_CERT_FILE=
PORTAL_PROVISION_TLS_CLIENT_KEY_FILE=
PORTAL_PROVISION_TLS_SERVER_NAME=
PORTAL_PROVISION_TLS_REQUIRE_MTLS=false
# Independent 32+ byte random pepper is recommended. If omitted, the existing
# SENSITIVE_HMAC_KEY_BASE64 material is used as a secure compatibility fallback.
PORTAL_INVITE_PEPPER_BASE64=
# Portal-to-CRM verify/consume uses the CRM machine-token audience above and
# signed scope portal.invite.verify, with timestamp + single-use nonce headers.

PLATFORM_EXTERNAL_IDENTITY_ENABLED=false
PLATFORM_EXTERNAL_USER_PROVISION_URL=https://identity.example.com/api/v1/internal/external-users
PLATFORM_APPLICATION_ROLE_ASSIGN_URL=https://identity.example.com/api/v1/internal/application-roles
PLATFORM_APPLICATION_ROLE_REVOKE_URL=https://identity.example.com/api/v1/internal/application-roles/revoke
PLATFORM_MANAGEMENT_TOKEN_URL=https://identity.example.com/oauth2/token
PLATFORM_PORTAL_APPLICATION_CODE=customer_portal
# CRM-to-platform owner directory uses its own least-privilege machine client.
OWNER_DIRECTORY_ENABLED=false
PLATFORM_OWNER_DIRECTORY_URL=https://identity.example.com/api/v1/internal/owner-directory
PLATFORM_OWNER_DIRECTORY_CLIENT_ID=
PLATFORM_OWNER_DIRECTORY_CLIENT_SECRET=
PLATFORM_OWNER_DIRECTORY_SCOPE=owner_directory.read
# These clients must remain separate and receive only their exact scope.
PLATFORM_EXTERNAL_USER_CLIENT_ID=
PLATFORM_EXTERNAL_USER_CLIENT_SECRET=
PLATFORM_EXTERNAL_USER_SCOPE=external_user.provision
PLATFORM_ROLE_ASSIGN_CLIENT_ID=
PLATFORM_ROLE_ASSIGN_CLIENT_SECRET=
PLATFORM_ROLE_ASSIGN_SCOPE=application_role.assign
PLATFORM_ROLE_REVOKE_CLIENT_ID=
PLATFORM_ROLE_REVOKE_CLIENT_SECRET=
PLATFORM_ROLE_REVOKE_SCOPE=application_role.revoke
PLATFORM_MANAGEMENT_TLS_ROOT_CA_FILE=
PLATFORM_MANAGEMENT_TLS_CLIENT_CERT_FILE=
PLATFORM_MANAGEMENT_TLS_CLIENT_KEY_FILE=
PLATFORM_MANAGEMENT_TLS_SERVER_NAME=
PLATFORM_MANAGEMENT_TLS_REQUIRE_MTLS=false

# TS-002 authoritative current-task query. Approval/rejection is not published
# and no action is accepted unless this server-side resolver confirms the
# current engine task for the authenticated approver.
APPROVAL_TASK_RESOLVER_ENABLED=false
APPROVAL_TASK_URL=https://approval.example.com/api/v1/internal/current-task
APPROVAL_TASK_TOKEN_URL=https://identity.example.com/oauth2/token
APPROVAL_TASK_CLIENT_ID=
APPROVAL_TASK_CLIENT_SECRET=
APPROVAL_TASK_SCOPE=presale.approval.task.read
APPROVAL_TASK_TLS_ROOT_CA_FILE=
APPROVAL_TASK_TLS_CLIENT_CERT_FILE=
APPROVAL_TASK_TLS_CLIENT_KEY_FILE=
APPROVAL_TASK_TLS_SERVER_NAME=
APPROVAL_TASK_TLS_REQUIRE_MTLS=false

# TS-001 admission uses persisted presale-worker liveness evidence. Use the
# same value on CRM and presale-worker; configuration never proves readiness.
PRESALE_WORKER_HEARTBEAT_MAX_AGE=15s

# CM-002 project history is an opt-in read of Portal-owned synchronized
# projections. The endpoint base must end at /internal/customers; CRM appends
# only the already-authorized numeric customer ID and strict pagination.
PORTAL_PROJECT_HISTORY_ENABLED=false
PORTAL_PROJECT_HISTORY_URL=https://portal.example.com/customer-portal/internal/customers
PORTAL_PROJECT_HISTORY_TOKEN_URL=https://identity.example.com/oauth2/token
PORTAL_PROJECT_HISTORY_CLIENT_ID=
PORTAL_PROJECT_HISTORY_CLIENT_SECRET=
PORTAL_PROJECT_HISTORY_SCOPE=portal.project_history.read

# BM-002 customer-bound contract verification. Keep this disabled until a
# dedicated CRM machine client is issued. The token request uses
# client_secret_basic and the exact least-privilege scope below. Resource
# requests deliberately carry no tenant header.
CONTRACT_VERIFICATION_ENABLED=false
CONTRACT_SUMMARY_URL=https://contract.example.com/internal/contract-summary
CONTRACT_SUMMARY_TOKEN_URL=https://identity.example.com/oauth2/token
CONTRACT_SUMMARY_CLIENT_ID=
CONTRACT_SUMMARY_CLIENT_SECRET=
CONTRACT_SUMMARY_SCOPE=contract.summary.read

# Optional read-only aggregation of signed contracts by opportunity. Keep this
# disabled until the contract provider implements the exact batch contract.
# CRM never persists or caches the returned counts; dependency failure is shown
# as unavailable and does not fail opportunity list, board or detail queries.
CONTRACT_SIGNED_COUNT_ENABLED=false
CONTRACT_SIGNED_COUNT_URL=https://contract.example.com/contract_management/internal/opportunity-contract-counts/query
CONTRACT_SIGNED_COUNT_TOKEN_URL=https://identity.example.com/oauth2/token
CONTRACT_SIGNED_COUNT_CLIENT_ID=
CONTRACT_SIGNED_COUNT_CLIENT_SECRET=
CONTRACT_SIGNED_COUNT_SCOPE=contract.opportunity_signed_count.read

# Optional active quotation/bid status read. The OAuth client is independent
# from the status callback writer and receives only opportunity.status.read.
QB_STATUS_QUERY_ENABLED=false
QB_STATUS_URL=
QB_STATUS_TOKEN_URL=
QB_STATUS_CLIENT_ID=
QB_STATUS_CLIENT_SECRET=
QB_STATUS_SCOPE=opportunity.status.read
QB_STATUS_TLS_ROOT_CA_FILE=
QB_STATUS_TLS_CLIENT_CERT_FILE=
QB_STATUS_TLS_CLIENT_KEY_FILE=
QB_STATUS_TLS_SERVER_NAME=
QB_STATUS_TLS_REQUIRE_MTLS=false

# Optional browser launch contexts. URLs are fixed at deployment startup and
# never accepted from browser requests. Use an independently rotated key.
QB_LAUNCH_ENABLED=false
QB_QUOTATION_PUBLIC_URL=
QB_BID_PUBLIC_URL=
QB_LAUNCH_SIGNING_KEY_BASE64=
QB_LAUNCH_TTL=2m

# TS-008 independent scanner. All duration arithmetic is UTC; the default
# cadence follows the approved 10-minute requirement.
PRESALE_ALERT_WORKER_ID=
PRESALE_ALERT_POLL_INTERVAL=10m
PRESALE_ALERT_LEASE_DURATION=1m
PRESALE_ALERT_BATCH_SIZE=200

# BM-002 independent stage-stay scanner. Only the five FOLLOWING stages are
# eligible. Site-message projection remains inside CRM.
OPPORTUNITY_ALERT_WORKER_ID=
OPPORTUNITY_ALERT_POLL_INTERVAL=10m
OPPORTUNITY_ALERT_LEASE_DURATION=1m
OPPORTUNITY_ALERT_BATCH_SIZE=200

# Attachment trust boundary. Local store is the development default; production
# should switch to an S3-compatible object store (AWS S3, MinIO, Aliyun OSS
# S3 endpoint) so scans and downloads bind to an immutable ETag version.
ATTACHMENT_LOCAL_ENABLED=true
ATTACHMENT_LOCAL_ROOT=/app/data/attachments
ATTACHMENT_S3_ENABLED=false
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_PATH_STYLE=true
ATTACHMENT_S3_PREFIX=crm-attachments

# 商机附件迁移默认保持 legacy；受控环境先切 dual 观察，再切 required。
ATTACHMENT_FILE_GATEWAY_MODE=legacy
ATTACHMENT_FILE_GATEWAY_BASE_URL=http://file-gateway:8086
ATTACHMENT_FILE_GATEWAY_TOKEN_URL=http://platform-api:8080/oauth2/token
ATTACHMENT_FILE_GATEWAY_APPLICATION_ID=
ATTACHMENT_FILE_GATEWAY_CLIENT_ID=
ATTACHMENT_FILE_GATEWAY_CLIENT_SECRET=
ATTACHMENT_FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind

# ClamAV engine scan shared by opportunity attachments and customer imports.
# When enabled, attachments get static content validation + engine scan and
# imports get engine scan before workbook parsing. Engine failures fail closed.
CLAMAV_ENABLED=false
CLAMAV_NETWORK=tcp
CLAMAV_ADDRESS=clamav:3310
